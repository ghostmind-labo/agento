{
  "name": "@ghostmind-dev/agento",
  "version": "0.7.0",
  "description": "agento: the agent engine (tool loop and guards, Jev as the guide, USD budgets, go/pause/stop hooks, an append-only event log) as a library, plus the `agento` command: a terminal agent that also runs in editors and chats over the Agent Client Protocol.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "agento": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./models": {
      "types": "./dist/cli/models.d.ts",
      "import": "./dist/cli/models.js"
    },
    "./a2a": {
      "types": "./dist/cli/a2a.d.ts",
      "import": "./dist/cli/a2a.js"
    },
    "./a2a-handler": {
      "types": "./dist/cli/a2a-handler.d.ts",
      "import": "./dist/cli/a2a-handler.js"
    },
    "./plugins": {
      "types": "./dist/cli/plugins.d.ts",
      "import": "./dist/cli/plugins.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "agent",
    "tool-loop",
    "llm",
    "openrouter",
    "jev",
    "typesafe",
    "mcp",
    "agent-skills",
    "hooks",
    "budget",
    "cli",
    "acp",
    "agent-client-protocol"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node test/run.mts",
    "pretest": "npm run build",
    "example": "node examples/two-tools.mts",
    "bench": "node bench/guidance.mts",
    "prepublishOnly": "npm run typecheck && npm test",
    "tck": "bash scripts/acp-tck.sh",
    "tck:a2a": "bash scripts/a2a-tck.sh"
  },
  "devDependencies": {
    "@ghostmind-dev/ensemble": "^0.31.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "@ghostmind-dev/ensemble": ">=0.31.0"
  },
  "peerDependenciesMeta": {
    "@ghostmind-dev/ensemble": {
      "optional": true
    }
  }
}
