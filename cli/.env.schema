# agent / cli: a terminal REPL to test the agent core (runs on the Mac, no Docker). Committed; pointers only.
# @plugin(@varlock/hashicorp-vault-plugin@2.1.1)
# @initHcpVault(url=$VAULT_ADDR, token=$VAULT_TOKEN, defaultPath=ghostmind/project/agento/cli)
# @currentEnv=$APP_ENV
# @defaultRequired=true
# @defaultSensitive=false
# ---
# The CLI only runs on the host, so there is only dev.
# @type=enum(dev, prod)
APP_ENV=dev
# @type=url
VAULT_ADDR=
# Your shell's token.
# @type=vaultToken @sensitive @required=false
VAULT_TOKEN=

# One key for the worker model and Jev (OpenRouter's /systemone).
# @sensitive
OPENROUTER_API_KEY=vaultSecret("ghostmind/global/openrouter")

# Optional: forces a model for every run (otherwise the default saved with `agento --pick`, or --model).
# @required=false
AGENT_MODEL=
# USD cap per turn when --max-usd is not given.
# @type=number
AGENT_MAX_USD=0.5
