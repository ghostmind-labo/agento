{
  "id": "aG7kQ2mXv9Lp",
  "name": "agento",
  "type": "project",
  "description": "agento: the agent engine as a library, and a terminal / ACP / MCP agent on top of it, plus its hosted product",
  "tags": [
    "agent",
    "agento",
    "ai"
  ],
  "routines": {
    "test": "npm test",
    "typecheck": "npm run typecheck",
    "build": "npm run build",
    "tck": "npm run tck",
    "herdr_init": "run herdr init agento --all",
    "herdr_attach": "run herdr attach agento",
    "herdr_terminate": "run herdr terminate agento"
  },
  "herdr": {
    "workspaces": [
      {
        "label": "agento",
        "tabs": [
          {
            "label": "dev",
            "prefix": false,
            "layout": "compact",
            "compact": {
              "type": "main-side",
              "panes": [
                {
                  "name": "main",
                  "description": "the engine and the agento command: git on the dev branch, run routine test, ad-hoc agento runs from the repo root"
                },
                {
                  "name": "execution-shell",
                  "description": "run ad-hoc commands here without interrupting other panes"
                }
              ]
            }
          },
          {
            "label": "shell",
            "prefix": false,
            "layout": "compact",
            "compact": {
              "type": "single",
              "panes": [
                {
                  "name": "shell",
                  "description": "a plain shell at the repo root"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
