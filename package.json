{
  "name": "@ghostmind-dev/agent",
  "version": "0.2.6",
  "description": "The agent engine every app builds its own agent from: the tool loop and its guards, a model seam (OpenRouter + Jev), the Jev guide, budgets with a USD cap, go/pause/stop hooks, and an append-only event log. A library, plus the `agento` command line to try it.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "agento": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "agent",
    "tool-loop",
    "llm",
    "openrouter",
    "jev",
    "typesafe",
    "mcp",
    "agent-skills",
    "hooks",
    "budget",
    "cli"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node test/run.mts",
    "pretest": "npm run build",
    "example": "node examples/two-tools.mts",
    "bench": "node bench/guidance.mts",
    "prepublishOnly": "npm run typecheck && npm test",
    "tck": "bash scripts/acp-tck.sh"
  },
  "devDependencies": {
    "@ghostmind-dev/ensemble": "^0.31.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "@ghostmind-dev/ensemble": ">=0.31.0"
  },
  "peerDependenciesMeta": {
    "@ghostmind-dev/ensemble": {
      "optional": true
    }
  }
}
